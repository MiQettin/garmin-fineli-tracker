# HealthManager Environment Variables
# Copy this file to .env and fill in your values

# Garmin Connect Credentials
# Required for fetching activity data from Garmin Connect
GARMIN_EMAIL=your-email@example.com
GARMIN_PASSWD=your-garmin-password

# Optional: Django settings
# Defaults work for local development. Set real values for any deployment.
DEBUG=True
SECRET_KEY=replace-this-with-a-random-secret-key
ALLOWED_HOSTS=127.0.0.1,localhost

# Optional: database location. Defaults to backend/db.sqlite3.
# On a server, point this outside the code checkout, e.g.
# DATABASE_PATH=/srv/healthmanager/db.sqlite3
